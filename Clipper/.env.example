# ClipForge Environment Configuration Example

# API Server
PROJECT_NAME="ClipForge"
API_V1_STR="/api/v1"
SECRET_KEY="clipforge-production-secret-key-change-me"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database
# Default SQLite for instant local zero-dependency development:
DATABASE_URL="sqlite+aiosqlite:///./data/clipforge.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/clipforge"

# Storage
STORAGE_TYPE="local" # local | s3
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY="your-s3-access-key"
# S3_SECRET_KEY="your-s3-secret-key"
# S3_BUCKET="clipforge-media"

# AI Providers
LLM_PROVIDER="gemini" # gemini | openai | anthropic | ollama | mock
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Transcriber Provider
TRANSCRIBER_PROVIDER="local" # local | gemini | openai | deepgram
DEEPGRAM_API_KEY=""

# Stock Media
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Social OAuth & Publishing
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REDIRECT_URI="http://localhost:3000/api/auth/callback/youtube"
