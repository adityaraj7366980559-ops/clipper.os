{
  "name": "clipforge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ClipForge - AI Video Clipping & Repurposing Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
